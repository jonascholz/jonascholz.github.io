---
import { render, type CollectionEntry } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getAllPosts, mdxComponents, readingTime, routeParam } from '../../lib/content';

export async function getStaticPaths() {
  // The pager only walks listed posts; unlisted ones get no neighbors.
  const posts = await getAllPosts();
  const listed = posts.filter((p) => !p.data.unlisted);
  const link = (p?: CollectionEntry<'posts'>) => p && { title: p.data.title, href: p.data.permalink };
  return posts.map((post) => {
    const i = listed.indexOf(post);
    return {
      params: { slug: routeParam(post.data.permalink, 'posts') },
      props: i < 0 ? { post } : { post, prev: link(listed[i + 1]), next: link(listed[i - 1]) },
    };
  });
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, tags, image, references, draft, unlisted } = post.data;
---

<Article
  title={title}
  description={description}
  date={date}
  tags={tags}
  image={image?.src}
  readingTime={readingTime(post)}
  references={references}
  eyebrow={draft ? 'Draft' : undefined}
  noindex={unlisted}
  headings={headings}
  back={{ label: 'Blog', href: '/blog/' }}
  prev={prev}
  next={next}
>
  <Content components={mdxComponents} />
</Article>
