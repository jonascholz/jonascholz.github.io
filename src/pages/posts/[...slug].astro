---
import { render, type CollectionEntry } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getPosts, mdxComponents, readingTime, routeParam } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  const link = (p?: CollectionEntry<'posts'>) => p && { title: p.data.title, href: p.data.permalink };
  return posts.map((post, i) => ({
    params: { slug: routeParam(post.data.permalink, 'posts') },
    props: { post, prev: link(posts[i + 1]), next: link(posts[i - 1]) },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, tags, image, references, draft } = post.data;
---

<Article
  title={title}
  description={description}
  date={date}
  tags={tags}
  image={image?.src}
  readingTime={readingTime(post)}
  references={references}
  eyebrow={draft ? 'Draft' : undefined}
  headings={headings}
  back={{ label: 'Writing', href: '/blog/' }}
  prev={prev}
  next={next}
>
  <Content components={mdxComponents} />
</Article>
