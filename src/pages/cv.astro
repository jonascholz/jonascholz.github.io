---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import profile from '../assets/profile.jpg';
import { site } from '../lib/site';

const skillIcons = import.meta.glob<{ default: ImageMetadata }>('../assets/skills/*.png', { eager: true });
const icon = (name: string) => skillIcons[`../assets/skills/${name}.png`].default;

const education = [
  { what: 'PhD at the Institut für Technik der Informationsverarbeitung (ITIV), KIT', when: 'ongoing' },
  { what: 'M.Sc. in Practical Computer Science, University of Hagen', when: '2025' },
  { what: 'B.Sc. in Applied Computer Science, Ruhr University Bochum', when: '2019' },
];

const work = [
  { role: 'PhD Candidate', org: 'KIT', when: '2025 - today', notes: ['Research on world models for robotics'] },
  {
    role: 'Research Assistant',
    org: 'FZI (Research Center)',
    when: '2024 - 2025',
    notes: ['Research on spiking neural networks, implementation of learning algorithms and presentations of findings'],
    link: '/projects/02_cartpole/',
  },
  {
    role: 'Research Associate',
    org: 'University of Hagen',
    when: '2023 - 2024',
    notes: ['Developed a component for unsupervised ML, worked on the EU project KnowlEdge and supported the Chair of Data Science'],
    link: '/projects/03_knowledge/',
  },
  {
    role: 'Software Developer',
    org: 'Adesso SE',
    when: '2020 - 2022',
    notes: ['Created fullstack solutions for 3+ large German companies', 'Upheld best practices (Clean Code, CI/CD, Design Patterns and more)'],
  },
];

const skills = [
  {
    group: 'AI & Neuromorphic Computing',
    items: [
      ['python', 'Python', 'https://www.python.org'],
      ['lava', 'Lava', 'https://lava-nc.org'],
      ['nest', 'Nest', 'https://www.nest-simulator.org'],
      ['tensorflow', 'TensorFlow', 'https://www.tensorflow.org'],
      ['sklearn', 'Scikit-learn', 'https://scikit-learn.org'],
      ['pandas', 'Pandas', 'https://pandas.pydata.org'],
      ['sql', 'SQL', 'https://www.postgresql.org'],
    ],
  },
  {
    group: 'Fullstack Development',
    items: [
      ['angular', 'Angular', 'https://angular.io'],
      ['javascript', 'JavaScript', 'https://developer.mozilla.org/en-US/docs/Web/JavaScript'],
      ['node', 'NodeJS', 'https://nodejs.org'],
      ['react', 'React', 'https://react.dev'],
      ['git', 'Git', 'https://git-scm.com'],
      ['typescript', 'TypeScript', 'https://www.typescriptlang.org'],
    ],
  },
];
---

<Base title="About" description="About Jona Scholz: education, experience and skills.">
  <div class="container narrow page">
    <header class="intro">
      <Image src={profile} alt="Jona Scholz" width={400} height={400} class="photo" loading="eager" />
      <div>
        <h1>Hi, I'm Jona</h1>
        <p>I'm working towards AGI. I wasted some time on SNNs and then went into world models. Prior to this I was a Software Developer.</p>
        <p class="contact">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          {site.links.map((l) => <a href={l.url} rel="me noopener">{l.label}</a>)}
        </p>
      </div>
    </header>

    <section>
      <h2>Education</h2>
      <ul class="timeline">
        {
          education.map((e) => (
            <li>
              <span class="when">{e.when}</span>
              <span>{e.what}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2>Work experience</h2>
      <ul class="timeline">
        {
          work.map((w) => (
            <li>
              <span class="when">{w.when}</span>
              <div>
                <strong>{w.role}</strong>, {w.org}
                <ul class="notes">
                  {w.notes.map((n) => (
                    <li>{n}</li>
                  ))}
                </ul>
                {w.link && <a href={w.link}>Learn more</a>}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2>Skills</h2>
      {
        skills.map((s) => (
          <>
            <h3>{s.group}</h3>
            <ul class="skills">
              {s.items.map(([key, label, url]) => (
                <li>
                  <a href={url} rel="noopener">
                    <Image src={icon(key)} alt="" width={48} height={48} />
                    <span>{label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        ))
      }
    </section>
  </div>
</Base>

<style>
  .page {
    padding-top: clamp(2rem, 6vw, 4rem);
  }

  .intro {
    display: flex;
    gap: 2rem;
    align-items: center;
    margin-bottom: 2.5rem;
  }

  .photo {
    width: 10rem;
    height: 10rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  h1 {
    font-size: clamp(1.9rem, 5vw, 2.4rem);
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
  }

  .intro p {
    margin: 0;
    color: var(--muted);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: 0.9rem !important;
    font-size: 0.9rem;
  }

  @media (max-width: 34rem) {
    .intro {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  h2 {
    font-size: 1.25rem;
    margin: 2.5rem 0 0.8rem;
  }

  h3 {
    font-size: 0.95rem;
    color: var(--muted);
    margin: 1.5rem 0 0.8rem;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline > li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    padding-block: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .when {
    color: var(--muted);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }

  .notes {
    margin: 0.3rem 0;
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .timeline a {
    font-size: 0.9rem;
  }

  @media (max-width: 34rem) {
    .timeline > li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .skills a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    width: 5rem;
    font-size: 0.82rem;
    color: var(--muted);
    text-decoration: none;
    transition: transform 0.2s;
  }

  .skills a:hover {
    transform: scale(1.08);
    color: var(--fg);
  }

  .skills img {
    width: 3rem;
    height: 3rem;
    object-fit: contain;
  }
</style>
