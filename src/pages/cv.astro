---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import profile from '../assets/profile.jpg';
import { site } from '../lib/site';

const education = [
  { what: 'PhD at the Institut für Technik der Informationsverarbeitung (ITIV), KIT', when: 'ongoing' },
  { what: 'M.Sc. in Practical Computer Science, University of Hagen', when: '2025' },
  { what: 'B.Sc. in Applied Computer Science, Ruhr University Bochum', when: '2019' },
];

const work = [
  { role: 'PhD Candidate', org: 'KIT', when: '2025 - today', notes: ['Research on generalist robots'] },
  {
    role: 'Research Assistant',
    org: 'FZI (Research Center)',
    when: '2024 - 2025',
    notes: ['Research on spiking neural networks, implementation of learning algorithms and presentations of findings'],
    link: '/projects/02_cartpole/',
  },
  {
    role: 'Research Associate',
    org: 'University of Hagen',
    when: '2023 - 2024',
    notes: ['Developed a component for unsupervised ML, worked on the EU project KnowlEdge and supported the Chair of Data Science'],
    // Hidden for now: link: '/projects/03_knowledge/',
  },
  {
    role: 'Software Developer',
    org: 'Adesso SE',
    when: '2020 - 2022',
    notes: ['Created fullstack solutions for 3+ large German companies', 'Upheld best practices (Clean Code, CI/CD, Design Patterns and more)'],
  },
];
---

<Base title="About" description="About Jona Scholz: education and experience.">
  <div class="container narrow page">
    <header class="intro">
      <Image src={profile} alt="Jona Scholz" width={400} height={400} class="photo" loading="eager" />
      <div>
        <h1 class="page-title">Hi, I'm Jona</h1>
        <p>I'm working towards AGI. I wasted some time on SNNs and then went into generalist robots. Prior to this I was a Software Developer.</p>
        <p class="contact">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          {site.links.map((l) => <a href={l.url} rel="me noopener">{l.label}</a>)}
        </p>
      </div>
    </header>

    <section>
      <h2>Education</h2>
      <ul class="timeline">
        {
          education.map((e) => (
            <li>
              <span class="when">{e.when}</span>
              <span>{e.what}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2>Work experience</h2>
      <ul class="timeline">
        {
          work.map((w) => (
            <li>
              <span class="when">{w.when}</span>
              <div>
                <strong>{w.role}</strong>, {w.org}
                <ul class="notes">
                  {w.notes.map((n) => (
                    <li>{n}</li>
                  ))}
                </ul>
                {w.link && <a href={w.link}>Learn more</a>}
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .page {
    padding-top: clamp(3rem, 8vw, 5.5rem);
  }

  .intro {
    display: flex;
    gap: 2rem;
    align-items: center;
    margin-bottom: 2.5rem;
  }

  .photo {
    width: 9rem;
    height: 9rem;
    border-radius: 28px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .intro p {
    margin: 0;
    color: var(--muted);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: 0.9rem !important;
    font-size: 0.9rem;
  }

  @media (max-width: 34rem) {
    .intro {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  h2 {
    font-size: 1.35rem;
    font-weight: 640;
    letter-spacing: -0.025em;
    margin: 3.5rem 0 0.9rem;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline > li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    padding-block: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .when {
    font-family: var(--font-mono);
    color: var(--faint);
    font-size: 0.78rem;
    padding-top: 0.2rem;
    font-variant-numeric: tabular-nums;
  }

  .notes {
    margin: 0.3rem 0;
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .timeline a {
    font-size: 0.9rem;
  }

  @media (max-width: 34rem) {
    .timeline > li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }

</style>
