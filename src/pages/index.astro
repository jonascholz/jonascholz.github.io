---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import RobotDemo from '../components/three/RobotDemo.astro';
import { getPosts, getProjects } from '../lib/content';
import { site } from '../lib/site';

const posts = (await getPosts()).slice(0, 5);
const projects = await getProjects();
---

<Base>
  <section class="hero">
    <div class="dot-grid backdrop" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="status"><span class="pulse" aria-hidden="true"></span>PhD at KIT · world models for robotics</p>
      <h1>
        Jona Scholz
        <span>Robot learning and world models.</span>
      </h1>
      <p class="lede">
        I'm a researcher at <a href={site.affiliation.url}>ITIV, Karlsruhe Institute of Technology</a>. Before robots I spent
        a good while trying to make spiking neural networks learn. This site collects derivations worked out step by step,
        project notes and interactive experiments.
      </p>
      <p class="actions">
        <a class="button primary" href="/blog/">Read the blog <span aria-hidden="true">→</span></a>
        <a class="button" href="/cv/">About me</a>
      </p>
    </div>

    <div class="container">
      <figure class="demo">
        <RobotDemo height="clamp(22rem, 46vw, 34rem)" />
        <figcaption>
          <span class="eyebrow">Live</span>
          MuJoCo physics compiled to WebAssembly, running in your browser. <a href="/lab/">How it works →</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="container section">
    <header class="section-head">
      <h2>Writing</h2>
      <a href="/blog/">All posts <span aria-hidden="true">→</span></a>
    </header>
    <PostList posts={posts} />
  </section>

  <section class="container section">
    <header class="section-head">
      <h2>Projects</h2>
      <a href="/projects/">All projects <span aria-hidden="true">→</span></a>
    </header>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    margin-top: -4rem;
    padding-top: 4rem;
  }

  .backdrop {
    position: absolute;
    inset: 0 0 auto 0;
    height: 46rem;
    z-index: -1;
  }

  .hero-inner {
    padding-block: clamp(3rem, 9vw, 6.5rem) clamp(2rem, 5vw, 3.5rem);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.6rem;
    padding: 0.3rem 0.8rem 0.3rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .pulse {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 0 rgb(34 197 94 / 0.5);
    animation: pulse 2.4s infinite;
  }

  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 7px rgb(34 197 94 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(34 197 94 / 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
    }
  }

  h1 {
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    font-weight: 660;
    line-height: 1.02;
    letter-spacing: -0.045em;
    margin: 0;
  }

  h1,
  h1 span {
    text-wrap: pretty;
  }

  h1 span {
    display: block;
    font-size: 0.8em;
    margin-top: 0.12em;
    color: var(--faint);
  }

  .lede {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.65;
    color: var(--muted);
    max-width: 40rem;
    margin: 1.75rem 0 0;
  }

  .lede a {
    color: var(--fg);
    text-decoration-color: var(--accent-line);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: 2rem 0 0;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.62rem 1.15rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--fg);
    font-weight: 550;
    font-size: 0.92rem;
    text-decoration: none;
    transition:
      transform 0.15s,
      border-color 0.15s,
      opacity 0.15s;
  }

  .button:hover {
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  .button.primary {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }

  .button.primary:hover {
    opacity: 0.9;
  }

  .demo {
    margin: 0;
  }

  .demo figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.8rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .demo figcaption a {
    color: var(--fg);
    text-decoration: none;
  }

  .demo figcaption a:hover {
    color: var(--accent);
  }

  .section {
    padding-top: clamp(4rem, 8vw, 6rem);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }

  .section-head h2 {
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 640;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .section-head a {
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
  }

  .section-head a:hover {
    color: var(--fg);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
</style>
