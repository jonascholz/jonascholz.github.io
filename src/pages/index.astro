---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import XLeRobot from '../components/sketches/XLeRobot.astro';
// Hidden for now: import RobotDemo from '../components/three/RobotDemo.astro';
import { getPosts, getProjects } from '../lib/content';
import { site } from '../lib/site';

const posts = (await getPosts()).slice(0, 5);
const projects = await getProjects();
---

<Base>
  <section class="hero">
    <div class="graph-paper backdrop" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div>
        <h1>Jona Scholz</h1>
        <p class="lede">
          I'm a PhD student at <a href={site.affiliation.url}>ITIV, Karlsruhe Institute of Technology</a>. Before robots I
          spent a good while trying to make spiking neural networks learn. This site collects <span class="scribble"
            >random notes<svg viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"
              ><path d="M1 6c15-3 30-4 48-2 17 2 33 1 50-3"></path></svg
            ></span
          > from stuff I'm working on.
        </p>
        <p class="actions">
          <a class="button primary" href="/blog/">Read the blog <span aria-hidden="true">→</span></a>
          <a class="button" href="/cv/">About me</a>
        </p>
      </div>
      <XLeRobot class="hero-sketch" />
    </div>

    {/* Hidden for now: live robot demo.
    <div class="container">
      <figure class="demo">
        <RobotDemo height="clamp(22rem, 46vw, 34rem)" />
        <figcaption>
          <span class="eyebrow">Live</span>
          MuJoCo physics compiled to WebAssembly, running in your browser. <a href="/lab/">How it works →</a>
        </figcaption>
      </figure>
    </div>
    */}
  </section>

  <section class="container section">
    <header class="section-head">
      <h2>Blog</h2>
      <a href="/blog/">All posts <span aria-hidden="true">→</span></a>
    </header>
    <PostList posts={posts} />
  </section>

  <section class="container section">
    <header class="section-head">
      <h2>Projects</h2>
      <a href="/projects/">All projects <span aria-hidden="true">→</span></a>
    </header>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    margin-top: -4rem;
    padding-top: 4rem;
  }

  .backdrop {
    position: absolute;
    inset: 0 0 auto 0;
    height: 46rem;
    z-index: -1;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2rem;
    padding-block: clamp(3rem, 9vw, 6.5rem) clamp(2rem, 5vw, 3.5rem);
  }

  .hero-inner :global(.hero-sketch) {
    width: clamp(12rem, 22vw, 17rem);
    transform: rotate(-3deg);
  }

  @media (max-width: 44rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }

    .hero-inner :global(.hero-sketch) {
      order: -1;
      justify-self: end;
      width: 8.5rem;
      margin-bottom: -2rem;
    }
  }

  h1 {
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    font-weight: 660;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: pretty;
    margin: 0;
  }

  .lede {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.65;
    color: var(--muted);
    max-width: 40rem;
    margin: 1.75rem 0 0;
  }

  .lede a {
    color: var(--fg);
    text-decoration-color: var(--accent-line);
  }

  /* Hand-drawn underline. */
  .scribble {
    position: relative;
    white-space: nowrap;
  }

  .scribble svg {
    position: absolute;
    left: -2%;
    bottom: -0.35em;
    width: 104%;
    height: 0.6em;
    overflow: visible;
  }

  .scribble path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.2;
    stroke-linecap: round;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: 2rem 0 0;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.62rem 1.15rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--fg);
    font-weight: 550;
    font-size: 0.92rem;
    text-decoration: none;
    transition:
      transform 0.15s,
      border-color 0.15s,
      opacity 0.15s;
  }

  .button:hover {
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  .button.primary {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }

  .button.primary:hover {
    opacity: 0.9;
  }

  .demo {
    margin: 0;
  }

  .demo figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.8rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .demo figcaption a {
    color: var(--fg);
    text-decoration: none;
  }

  .demo figcaption a:hover {
    color: var(--accent);
  }

  .section {
    padding-top: clamp(4rem, 8vw, 6rem);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }

  .section-head h2 {
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 640;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .section-head a {
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: none;
  }

  .section-head a:hover {
    color: var(--fg);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
</style>
