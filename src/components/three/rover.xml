<mujoco model="rover-arena">
  <option timestep="0.004" integrator="implicitfast"/>

  <default>
    <geom friction="0.9 0.005 0.0001" solref="0.01 1"/>
    <default class="wall">
      <geom type="box" rgba="0.55 0.58 0.66 1"/>
    </default>
    <default class="crate">
      <geom type="box" size="0.07 0.07 0.07" mass="0.25" group="1" rgba="0.95 0.62 0.25 1"/>
    </default>
    <default class="ball">
      <geom type="sphere" size="0.06" mass="0.15" group="1" rgba="0.36 0.55 0.95 1"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="2 1.5 0.05" rgba="0.92 0.92 0.9 1"/>
    <geom class="wall" name="wall_n" pos="0 1.55 0.1" size="2.1 0.05 0.1"/>
    <geom class="wall" name="wall_s" pos="0 -1.55 0.1" size="2.1 0.05 0.1"/>
    <geom class="wall" name="wall_e" pos="2.05 0 0.1" size="0.05 1.5 0.1"/>
    <geom class="wall" name="wall_w" pos="-2.05 0 0.1" size="0.05 1.5 0.1"/>
    <geom class="wall" name="pillar_a" type="cylinder" pos="-0.9 0.5 0.15" size="0.12 0.15"/>
    <geom class="wall" name="pillar_b" type="cylinder" pos="1.0 -0.5 0.15" size="0.12 0.15"/>

    <body name="rover" pos="0 0 0.055">
      <freejoint name="rover"/>
      <geom name="chassis" type="box" size="0.11 0.075 0.025" mass="1.2" rgba="0.15 0.17 0.22 1"/>
      <geom name="deck" type="box" pos="-0.02 0 0.035" size="0.07 0.06 0.01" mass="0.1" rgba="0.92 0.94 0.97 1"/>
      <geom name="lidar" type="cylinder" pos="0.06 0 0.05" size="0.03 0.015" mass="0.05" rgba="0.95 0.35 0.3 1"/>
      <geom name="caster_front" type="sphere" pos="0.085 0 -0.031" size="0.02" mass="0.02" friction="0 0 0" condim="1" rgba="0.6 0.6 0.6 1"/>
      <geom name="caster_back" type="sphere" pos="-0.085 0 -0.031" size="0.02" mass="0.02" friction="0 0 0" condim="1" rgba="0.6 0.6 0.6 1"/>
      <body name="wheel_left" pos="0 0.095 0" zaxis="0 1 0">
        <joint name="wheel_left" type="hinge" axis="0 0 1" damping="0.002"/>
        <geom type="cylinder" size="0.055 0.015" mass="0.1" friction="1.4 0.01 0.0001" rgba="0.1 0.1 0.1 1"/>
      </body>
      <body name="wheel_right" pos="0 -0.095 0" zaxis="0 1 0">
        <joint name="wheel_right" type="hinge" axis="0 0 1" damping="0.002"/>
        <geom type="cylinder" size="0.055 0.015" mass="0.1" friction="1.4 0.01 0.0001" rgba="0.1 0.1 0.1 1"/>
      </body>
    </body>

    <body name="crate_1" pos="0.6 0.6 0.07"><freejoint/><geom class="crate"/></body>
    <body name="crate_2" pos="-0.4 -0.7 0.07" euler="0 0 30"><freejoint/><geom class="crate"/></body>
    <body name="crate_3" pos="1.4 0.9 0.07" euler="0 0 15"><freejoint/><geom class="crate"/></body>
    <body name="ball_1" pos="-1.3 -0.4 0.06"><freejoint/><geom class="ball"/></body>
    <body name="ball_2" pos="0.3 -1.0 0.06"><freejoint/><geom class="ball"/></body>

    <body name="goal" mocap="true" pos="1.2 0.2 0.002">
      <geom name="goal" type="cylinder" size="0.08 0.002" contype="0" conaffinity="0" rgba="0.2 0.75 0.45 0.6"/>
    </body>
  </worldbody>

  <actuator>
    <velocity name="wheel_left" joint="wheel_left" kv="0.08" ctrlrange="-16 16" forcerange="-0.6 0.6"/>
    <velocity name="wheel_right" joint="wheel_right" kv="0.08" ctrlrange="-16 16" forcerange="-0.6 0.6"/>
  </actuator>

</mujoco>
