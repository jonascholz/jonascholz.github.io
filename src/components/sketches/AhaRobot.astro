---
/**
 * Sketch of an AhaRobot: a lifting column on a wheeled base with two
 * horizontal SCARA-style arms and a pan-tilt camera head.
 * Line art in the hand-drawn style shared by all sketches (see .sketch in
 * global.css): plain shapes, roughened at build time by `rough()`.
 */
import { rough } from './rough';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const r = rough(9);
---

<svg class:list={['sketch', className]} viewBox="0 0 200 260" aria-hidden="true">
  <g>
    {/* base */}
    <path class="fill" d={r.path('M48 210h104l6 22H42z')} />
    <path class="line" d={r.path('M48 210h104l6 22H42z')} />
    <path class="line" d={r.circle(66, 236, 13)} /><path class="line" d={r.circle(134, 236, 13)} />
    <path class="thin" d={r.circle(66, 236, 4)} /><path class="thin" d={r.circle(134, 236, 4)} />
    {/* lifting column */}
    <path class="line" d={r.path('M91 210V44M109 210V44M91 44h18')} />
    <path class="thin" d={r.path('M100 50V204')} />
    {/* carriage */}
    <path class="fill" d={r.rect(80, 104, 40, 22, 3)} />
    <path class="line" d={r.rect(80, 104, 40, 22, 3)} />
    {/* left scara arm */}
    <path class="link" d={r.path('M80 113 52 119 28 110')} /><path class="link-core" d={r.path('M80 113 52 119 28 110')} />
    <path class="fill" d={r.circle(52, 119, 4)} /><path class="line" d={r.circle(52, 119, 4)} />
    <path class="fill" d={r.rect(21, 106, 13, 10, 2)} /><path class="line" d={r.rect(21, 106, 13, 10, 2)} />
    <path class="line" d={r.path('M24 116l-2 14M31 116l2 14')} />
    {/* right scara arm */}
    <path class="link" d={r.path('M120 113 148 119 172 110')} /><path class="link-core" d={r.path('M120 113 148 119 172 110')} />
    <path class="fill" d={r.circle(148, 119, 4)} /><path class="line" d={r.circle(148, 119, 4)} />
    <path class="fill" d={r.rect(166, 106, 13, 10, 2)} /><path class="line" d={r.rect(166, 106, 13, 10, 2)} />
    <path class="line" d={r.path('M169 116l-2 14M176 116l2 14')} />
    {/* head on gimbal */}
    <path class="line" d={r.path('M100 44V34')} />
    <path class="line" d={r.path('M88 34h24')} />
    <path class="fill" d={r.rect(80, 14, 40, 18, 6)} />
    <path class="line" d={r.rect(80, 14, 40, 18, 6)} />
    <path class="solid" d={r.circle(92, 23, 3.6)} /><path class="solid" d={r.circle(108, 23, 3.6)} />
  </g>
</svg>
