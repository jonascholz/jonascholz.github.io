---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import { formatDate } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  tags?: string[];
  image?: string;
  /** Minutes, shown in the byline. */
  readingTime?: number;
  references?: { id: string; text: string }[];
  eyebrow?: string;
  /** Section headings for the table of contents. */
  headings?: MarkdownHeading[];
  back?: { label: string; href: string };
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
  /** Ask search engines not to index the page (unlisted posts). */
  noindex?: boolean;
}

const {
  title,
  description,
  date,
  tags = [],
  image,
  readingTime,
  references = [],
  eyebrow,
  headings = [],
  back,
  prev,
  next,
  noindex,
} = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
if (references.length > 0) toc.push({ depth: 2, slug: 'references', text: 'References' });
---

<Base title={title} description={description} image={image} math type="article" noindex={noindex}>
  <div class="progress" aria-hidden="true"></div>
  <div class="container layout">
    <article class="article">
      <header class="article-header">
        {back && <a class="back" href={back.href}>← {back.label}</a>}
        <p class="meta">
          {eyebrow && <span class="badge">{eyebrow}</span>}
          {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
          {readingTime && <span>{readingTime} min read</span>}
        </p>
        <h1>{title}</h1>
        {description && <p class="description">{description}</p>}
        {tags.length > 0 && <p class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</p>}
      </header>

      <div class="prose">
        <slot />
      </div>

      {
        references.length > 0 && (
          <section class="references" aria-labelledby="references">
            <h2 id="references">References</h2>
            <ol>
              {references.map((r) => (
                <li id={`ref-${r.id}`} set:html={r.text} />
              ))}
            </ol>
          </section>
        )
      }

      {
        (prev || next) && (
          <nav class="pager" aria-label="More posts">
            {prev ? (
              <a href={prev.href} rel="prev">
                <span class="eyebrow">← Older</span>
                {prev.title}
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a href={next.href} rel="next" class="next">
                <span class="eyebrow">Newer →</span>
                {next.title}
              </a>
            )}
          </nav>
        )
      }
    </article>

    {
      toc.length > 2 && (
        <aside class="toc" aria-label="On this page">
          <p class="eyebrow">On this page</p>
          <ul>
            {toc.map((h) => (
              <li class={`depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</Base>

<script>
  // Copy buttons on code blocks.
  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-button';
    button.textContent = 'Copy';
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
      button.textContent = 'Copied';
      setTimeout(() => (button.textContent = 'Copy'), 1200);
    });
    pre.append(button);
  }

  // Anchor links on section headings.
  for (const h of document.querySelectorAll<HTMLHeadingElement>('.prose :is(h2, h3)[id]')) {
    const a = document.createElement('a');
    a.className = 'heading-anchor';
    a.href = `#${h.id}`;
    a.textContent = '#';
    a.setAttribute('aria-label', `Link to “${h.textContent}”`);
    h.append(a);
  }

  // Highlight the table of contents entry of the section being read.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.toc a')].map((a) => [decodeURIComponent(a.hash.slice(1)), a]),
  );
  if (links.size) {
    const visible = new Set<string>();
    const order = [...links.keys()];
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id);
        const current = order.find((id) => visible.has(id));
        if (!current) return;
        for (const [id, a] of links) a.classList.toggle('active', id === current);
      },
      { rootMargin: '-15% 0px -70% 0px' },
    );
    for (const id of order) {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    }
  }
</script>

<style>
  .progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 2px;
    z-index: 60;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(0);
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .progress {
      display: block;
      animation: progress linear both;
      animation-timeline: scroll(root);
    }

    @keyframes progress {
      to {
        transform: scaleX(1);
      }
    }
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, var(--measure));
    justify-content: center;
    gap: 4rem;
  }

  @media (min-width: 78rem) {
    .layout {
      grid-template-columns: 13rem minmax(0, var(--measure)) 13rem;
    }

    .article {
      grid-column: 2;
    }
  }

  .article {
    padding-top: clamp(2.5rem, 7vw, 5rem);
    min-width: 0;
  }

  .article-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.88rem;
    color: var(--muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--fg);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }

  .badge {
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  h1 {
    font-size: clamp(2rem, 5.2vw, 3rem);
    font-weight: 650;
    line-height: 1.08;
    letter-spacing: -0.035em;
    margin: 0.9rem 0 0;
  }

  .description {
    margin: 1rem 0 0;
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1.4rem 0 0;
  }

  .toc {
    display: none;
  }

  @media (min-width: 78rem) {
    .toc {
      display: block;
      grid-column: 3;
      grid-row: 1;
      position: sticky;
      top: 6rem;
      align-self: start;
      margin-top: 12rem;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
      font-size: 0.82rem;
    }
  }

  .toc ul {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    border-left: 1px solid var(--border);
  }

  .toc li.depth-3 {
    padding-left: 0.8rem;
  }

  .toc a {
    display: block;
    margin-left: -1px;
    padding: 0.28rem 0 0.28rem 0.9rem;
    border-left: 1px solid transparent;
    color: var(--muted);
    text-decoration: none;
    line-height: 1.4;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  .toc a:hover {
    color: var(--fg);
  }

  .toc a.active {
    color: var(--fg);
    border-left-color: var(--accent);
  }

  .references {
    margin-top: 4rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .references h2 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 1rem;
    color: var(--fg);
  }

  .references ol {
    padding-left: 1.5rem;
    margin: 0;
  }

  .references li + li {
    margin-top: 0.6rem;
  }

  .references li::marker {
    font-family: var(--font-mono);
    font-size: 0.8em;
  }

  .references li:target {
    color: var(--fg);
  }

  .references :global(a) {
    color: var(--accent);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4.5rem;
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--fg);
    text-decoration: none;
    font-weight: 560;
    line-height: 1.35;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }

  .pager a:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
  }

  .pager .next {
    text-align: right;
    grid-column: 2;
  }

  @media (max-width: 34rem) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager .next {
      grid-column: 1;
    }
  }
</style>
