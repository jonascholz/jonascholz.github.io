---
import Base from './Base.astro';
import { formatDate } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  tags?: string[];
  image?: string;
  /** Minutes, shown in the byline. */
  readingTime?: number;
  references?: { id: string; text: string }[];
  eyebrow?: string;
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
}

const { title, description, date, tags = [], image, readingTime, references = [], eyebrow, prev, next } = Astro.props;
---

<Base title={title} description={description} image={image} math type="article">
  <article class="container narrow article">
    <header class="article-header">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="byline">
        {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
        {readingTime && <span>{readingTime} min read</span>}
        {tags.map((t) => <span class="tag">{t}</span>)}
      </p>
    </header>

    <div class="prose">
      <slot />
    </div>

    {
      references.length > 0 && (
        <section class="references" aria-labelledby="references">
          <h2 id="references">References</h2>
          <ol>
            {references.map((r) => (
              <li id={`ref-${r.id}`} set:html={r.text} />
            ))}
          </ol>
        </section>
      )
    }

    {
      (prev || next) && (
        <nav class="pager" aria-label="More posts">
          {prev ? (
            <a href={prev.href} rel="prev">
              <span class="eyebrow">Older</span>
              {prev.title}
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a href={next.href} rel="next" class="next">
              <span class="eyebrow">Newer</span>
              {next.title}
            </a>
          )}
        </nav>
      )
    }
  </article>
</Base>

<script>
  // Copy buttons on code blocks.
  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-button';
    button.textContent = 'Copy';
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
      button.textContent = 'Copied';
      setTimeout(() => (button.textContent = 'Copy'), 1200);
    });
    pre.append(button);
  }
</script>

<style>
  .article {
    padding-top: clamp(2rem, 6vw, 4rem);
  }

  .article-header {
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0.3rem 0 0.9rem;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.8rem;
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .references {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
    color: var(--muted);
  }

  .references h2 {
    font-size: 1rem;
    margin: 0 0 1rem;
    color: var(--fg);
  }

  .references ol {
    padding-left: 1.5rem;
    margin: 0;
  }

  .references li + li {
    margin-top: 0.6rem;
  }

  .references li:target {
    color: var(--fg);
    background: var(--accent-soft);
    border-radius: 4px;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4rem;
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--fg);
    text-decoration: none;
    font-weight: 550;
    line-height: 1.35;
  }

  .pager a:hover {
    border-color: var(--accent);
  }

  .pager .next {
    text-align: right;
    grid-column: 2;
  }

  @media (max-width: 34rem) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager .next {
      grid-column: 1;
    }
  }
</style>
